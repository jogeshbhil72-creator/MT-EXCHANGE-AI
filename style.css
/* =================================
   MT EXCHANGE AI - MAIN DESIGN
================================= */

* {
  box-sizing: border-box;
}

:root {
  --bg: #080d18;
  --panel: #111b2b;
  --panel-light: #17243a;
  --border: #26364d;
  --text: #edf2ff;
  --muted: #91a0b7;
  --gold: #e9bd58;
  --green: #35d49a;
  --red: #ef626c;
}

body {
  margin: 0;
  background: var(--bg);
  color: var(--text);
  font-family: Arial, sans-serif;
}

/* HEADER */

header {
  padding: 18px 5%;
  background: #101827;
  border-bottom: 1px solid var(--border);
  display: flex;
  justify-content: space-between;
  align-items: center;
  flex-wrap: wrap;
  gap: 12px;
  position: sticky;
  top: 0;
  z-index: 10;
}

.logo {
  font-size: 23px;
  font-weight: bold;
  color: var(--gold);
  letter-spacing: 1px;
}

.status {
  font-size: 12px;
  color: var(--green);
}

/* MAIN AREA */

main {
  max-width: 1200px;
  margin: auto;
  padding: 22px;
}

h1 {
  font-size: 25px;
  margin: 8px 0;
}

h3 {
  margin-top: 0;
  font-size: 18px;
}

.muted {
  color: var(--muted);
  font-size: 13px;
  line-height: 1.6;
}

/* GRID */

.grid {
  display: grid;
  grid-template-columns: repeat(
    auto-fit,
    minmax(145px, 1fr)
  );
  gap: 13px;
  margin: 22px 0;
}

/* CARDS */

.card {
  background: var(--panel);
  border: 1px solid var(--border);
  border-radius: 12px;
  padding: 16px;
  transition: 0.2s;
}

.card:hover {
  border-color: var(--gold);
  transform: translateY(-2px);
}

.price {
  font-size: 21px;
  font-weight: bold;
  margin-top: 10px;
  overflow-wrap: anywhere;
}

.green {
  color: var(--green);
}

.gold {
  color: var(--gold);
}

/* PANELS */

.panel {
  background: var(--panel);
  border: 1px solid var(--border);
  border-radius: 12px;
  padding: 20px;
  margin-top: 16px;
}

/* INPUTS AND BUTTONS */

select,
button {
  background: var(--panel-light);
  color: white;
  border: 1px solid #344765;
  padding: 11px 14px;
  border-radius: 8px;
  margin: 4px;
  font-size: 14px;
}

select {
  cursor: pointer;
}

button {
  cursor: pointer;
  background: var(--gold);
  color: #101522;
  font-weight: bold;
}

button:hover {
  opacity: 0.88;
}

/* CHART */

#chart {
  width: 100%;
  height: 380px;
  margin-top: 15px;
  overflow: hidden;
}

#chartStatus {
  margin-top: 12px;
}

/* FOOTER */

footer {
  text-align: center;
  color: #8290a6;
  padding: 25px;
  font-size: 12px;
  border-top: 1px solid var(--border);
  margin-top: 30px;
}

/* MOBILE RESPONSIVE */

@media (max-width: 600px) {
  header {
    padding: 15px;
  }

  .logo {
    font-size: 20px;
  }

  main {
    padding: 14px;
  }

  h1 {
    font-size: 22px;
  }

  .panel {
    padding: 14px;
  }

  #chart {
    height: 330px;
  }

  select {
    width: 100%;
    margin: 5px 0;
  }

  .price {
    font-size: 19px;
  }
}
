
/* =================================
   MT EXCHANGE AI - MAIN DESIGN
================================= */

* {
  box-sizing: border-box;
}

:root {
  --bg: #080d18;
  --panel: #111b2b;
  --panel-light: #17243a;
  --border: #26364d;
  --text: #edf2ff;
  --muted: #91a0b7;
  --gold: #e9bd58;
  --green: #35d49a;
  --red: #ef626c;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, sans-serif;
}

/* HEADER */

header {
  padding: 18px 5%;
  background: #101827;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  position: sticky;
  top: 0;
  z-index: 10;
}

.logo {
  font-size: 23px;
  font-weight: bold;
  color: var(--gold);
  letter-spacing: 1px;
}

.status {
  font-size: 12px;
  color: var(--green);
}

/* MAIN AREA */

main {
  max-width: 1200px;
  margin: auto;
  padding: 22px;
}

h1 {
  font-size: 25px;
  margin: 8px 0;
}

h3 {
  margin-top: 0;
  font-size: 18px;
}

.muted {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}

/* GRID */

.grid {
  display: grid;
  grid-template-columns: repeat(
    auto-fit,
    minmax(145px, 1fr)
  );
  gap: 13px;
  margin: 22px 0;
}

/* CARDS */

.card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 16px;
  transition: 0.2s;
}

.card:hover {
  border-color: var(--gold);
  transform: translateY(-2px);
}

.price {
  font-size: 21px;
  font-weight: bold;
  margin-top: 10px;
  overflow-wrap: anywhere;
}

.green {
  color: var(--green);
}

.gold {
  color: var(--gold);
}

/* PANELS */

.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px;
  margin-top: 16px;
}

/* INPUTS AND BUTTONS */

select,
button {
  background: var(--panel-light);
  color: white;
  border: 1px solid #344765;
  padding: 11px 14px;
  border-radius: 8px;
  margin: 4px;
  font-size: 14px;
}

select {
  cursor: pointer;
}

button {
  cursor: pointer;
  background: var(--gold);
  color: #101522;
  font-weight: bold;
}

button:hover {
  opacity: 0.88;
}

/* CHART */

#chart {
  width: 100%;
  height: 380px;
  margin-top: 15px;
  overflow: hidden;
}

#chartStatus {
  margin-top: 12px;
}

/* FOOTER */

footer {
  text-align: center;
  color: #8290a6;
  padding: 25px;
  font-size: 12px;
  border-top: 1px solid var(--border);
  margin-top: 30px;
}

/* MOBILE RESPONSIVE */

@media (max-width: 600px) {
  header {
    padding: 15px;
  }

  .logo {
    font-size: 20px;
  }

  main {
    padding: 14px;
  }

  h1 {
    font-size: 22px;
  }

  .panel {
    padding: 14px;
  }

  #chart {
    height: 330px;
  }

  select {
    width: 100%;
    margin: 5px 0;
  }

  .price {
    font-size: 19px;
  }